# Copy this file to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. On Render these are set as real environment variables
# in the dashboard instead.

# ---- Core ----
# Any non-empty string works for local dev. Generate a fresh one for real use:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-change-me

# Show full error pages + serve static/media locally. NEVER "True" on Render.
DEBUG=True

# Comma-separated. Not needed locally (localhost/127.0.0.1 are always allowed).
# ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS=

# ---- Database ----
# Leave DATABASE_URL unset locally to use the bundled SQLite file (db.sqlite3).
# On Render this points at Postgres, e.g.:
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# ---- Media storage (Supabase) ----
# The switch is the presence of BOTH SUPABASE_URL and SUPABASE_KEY:
#   - unset (default)  -> every image/file upload saves to the local
#                         `media/` folder and is served from /media/.
#   - both set         -> every upload goes to the single Supabase bucket
#                         below (organised into folders per model).
# Nothing else changes; no code edit needed to flip between the two.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=<service_role key - needs storage write access, not the anon key>
# SUPABASE_BUCKET_NAME=images   # one PUBLIC bucket for everything, incl. payment proofs

# ---- Render-only ----
# RENDER=true            # enables the keep-alive self-ping thread
# APP_URL=https://whitemeatcompany.com
